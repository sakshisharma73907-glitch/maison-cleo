# Server — copy to .env and fill in real values
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/maison-cleo

# Absolute URL of the React dev server (used for CORS + Stripe redirects)
CLIENT_ORIGIN=http://localhost:5173

# 32+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Stripe (https://dashboard.stripe.com/apikeys). Test keys are fine for development.
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Stripe CLI (dev webhook forwarding): stripe listen --forward-to localhost:5000/api/payments/webhook

# Admin seeded by `npm run seed`
ADMIN_EMAIL=admin@maisoncleo.com
ADMIN_PASSWORD=MaisonCleo-2026!

# Optional SMTP. If unset, confirmation emails are logged to the console.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Maison Cleo <no-reply@maisoncleo.com>"